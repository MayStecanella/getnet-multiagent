# LLM dos agentes (qualquer provedor suportado pelo init_chat_model do LangChain)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# LLM do agente de Qualidade: modelo diferente do gerador, para não virar autoavaliação
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o
# Para usar Anthropic, instale langchain-anthropic e configure, por exemplo:
# JUDGE_PROVIDER=anthropic
# JUDGE_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# Embeddings do RAG (multilíngue: as fontes misturam inglês e português)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Busca na web (Tavily). Sem chave, perguntas de web recebem uma resposta de indisponibilidade.
TAVILY_API_KEY=

# Parâmetros do RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4
MAX_PAGES_PER_SOURCE=150
# Fontes e exclusões do crawl: os padrões estão em app/config.py. Só defina para sobrescrever.
# RAG_SOURCES=
# RAG_EXCLUDE=/blog/,/carreira,/careers

# Qualidade: janela de recontato em horas
RECONTACT_WINDOW_HOURS=24

# true = sobe a API sem rodar a ingestão (útil em desenvolvimento)
SKIP_INGEST=false
# Pasta do índice RAG (vazio = DATA_DIR/chroma). No Render: /app/data/index (índice versionado)
CHROMA_DIR=

# Modo off-line: LLM, RAG e busca web simulados, sem chave e sem internet (demonstração e testes)
OFFLINE_MODE=false

# Transbordo: na N-ésima pergunta sobre o mesmo tema na mesma conversa, vai para o especialista
HANDOFF_AFTER_ATTEMPTS=4

# Proteção da versão publicada: código pedido pelas telas e pela API (vazio = sem proteção)
ACCESS_CODE=
RATE_LIMIT_PER_MINUTE=12
DAILY_MESSAGE_CAP=500
BATCH_MAX_ROWS=100
